{
  "name": "knboard",
  "private": true,
  "version": "1.0.5",
  "description": "KNBoard - Ứng dụng Soạn Đề Thi Thông Minh, Bảng Vẽ Toán 2D/3D & Trình Chiếu Giảng Dạy XP-Pen",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bump-version": "npx tsx scripts/bump-version.ts",
    "build:exe": "npm run build && dotnet publish desktop-shell/KNBoard.csproj -c Release -r win-x64 --self-contained false -o release/KNBoard-win-x64"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "docx": "^8.5.0",
    "file-saver": "^2.0.5",
    "katex": "^0.16.11",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
