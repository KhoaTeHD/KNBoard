{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KNBoard",
  "version": "1.0.3",
  "identifier": "com.knboard.edu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KNBoard — Soạn Đề Thi, Bảng Vẽ Toán 2D/3D & Giảng Dạy XP-Pen",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KhoaTeHD/KNBoard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQzg1QTQyRkY0RTVFMTkKUldRWlhrNy9RbHJJdStVZEJ1UVM5NVVHYWNhbXhxM2tSWVB5TVJYYXBNaUVwMXhja2FuYmtzYU4K"
    }
  }
}
